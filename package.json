{
  "name": "superapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm -w @cw/api run dev",
    "dev:admin": "npm -w @cw/admin run dev",
    "dev:store": "npm -w @cw/storefront run dev",
    "db:migrate": "npm -w @cw/api run migrate",
    "db:seed": "npm -w @cw/api run seed",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:demo": "npm -w @cw/demo run build"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
